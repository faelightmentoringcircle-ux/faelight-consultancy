# =====================================================================
# Faelight Business Consultancy — environment variables
# ---------------------------------------------------------------------
# The DEMO runs with NONE of these set. Data persists in the browser
# (localStorage), the booking calendar + availability are simulated, and
# confirmation "emails" are shown on screen instead of sent.
#
# When you are ready to wire up the real backends, fill these in. The
# app is structured (see src/lib/*) so these drop in without a redesign.
# =====================================================================

# --- Supabase (Postgres + Auth for admin/team) -----------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Calendar API (booking availability + event creation) -----
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback

# --- Resend (booking + inquiry email notifications) ------------------
RESEND_API_KEY=
NOTIFY_EMAIL=faelightmentoringcircle@gmail.com

# --- App ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
